<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet author="svenglauser" id="changement-piece-create-table">
        <createTable tableName="CHANGEMENT_PIECE">
            <column autoIncrement="true" name="ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CHANGEMENT_PIECE"/>
            </column>

            <column name="CREATION_DATE" type="DATETIME"/>
            <column name="CREATION_USER" type="VARCHAR(255)"/>
            <column name="MODIFICATION_DATE" type="DATETIME"/>
            <column name="MODIFICATION_USER" type="VARCHAR(255)"/>

            <column name="SERVICE_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="PIECE_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="DESCRIPTION" type="VARCHAR(4096)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="SERVICE_ID"
                                 baseTableName="CHANGEMENT_PIECE"
                                 constraintName="FK_CHANGEMENT_PIECE_SERVICE_ID"
                                 referencedColumnNames="ID"
                                 referencedTableName="SERVICE"/>

        <addForeignKeyConstraint baseColumnNames="PIECE_ID"
                                 baseTableName="CHANGEMENT_PIECE"
                                 constraintName="FK_CHANGEMENT_PIECE_PIECE_ID"
                                 referencedColumnNames="ID"
                                 referencedTableName="PIECE"/>
    </changeSet>
</databaseChangeLog>